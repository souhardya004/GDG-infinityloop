# Copy to .env.docker and adjust before:
#   docker compose --env-file .env.docker -f docker-compose.prod.yml up -d --build

# App
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=*
HTTP_PORT=80

# Public URL of the frontend (used for CORS / CSRF)
PUBLIC_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost
CSRF_TRUSTED_ORIGINS=http://localhost

# Postgres (must match DATABASE_URL below)
POSTGRES_USER=codescope
POSTGRES_PASSWORD=change-me
POSTGRES_DB=codescope
DATABASE_URL=postgres://codescope:change-me@postgres:5432/codescope
DB_SSL_REQUIRE=False

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_ALWAYS_EAGER=False

# Neo4j (set NEO4J_ENABLED=False to skip — Postgres snapshots still work)
NEO4J_ENABLED=true
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# Storage
MEDIA_ROOT=/app/media
MAX_UPLOAD_MB=512
