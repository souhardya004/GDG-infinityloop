# Django
DEBUG=True
SECRET_KEY=dev-only-change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex for Vercel preview deploys, e.g. ^https://.*\.vercel\.app$
CORS_ALLOWED_ORIGIN_REGEXES=

# Database — default SQLite for local; set DATABASE_URL for Postgres (required on Render)
# DATABASE_URL=postgres://codescope:codescope@localhost:5432/codescope
DATABASE_URL=

# Redis / Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
REDIS_URL=redis://localhost:6379/0
# True = run tasks in-process (local dev without Redis). False = use Celery worker (production).
CELERY_TASK_ALWAYS_EAGER=True

# Neo4j (optional — Postgres snapshots work without it)
NEO4J_ENABLED=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=codescope-neo4j

# Storage (Render has ephemeral disk — uploaded ZIPs are lost on redeploy unless you use external storage)
MEDIA_ROOT=
MAX_UPLOAD_MB=512

# --- Production (Render) example ---
# DEBUG=False
# ALLOWED_HOSTS=.onrender.com
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app
# DATABASE_URL=<auto-set by Render Postgres>
# REDIS_URL=<auto-set by Render Redis>
# CELERY_TASK_ALWAYS_EAGER=False
# NEO4J_ENABLED=False
